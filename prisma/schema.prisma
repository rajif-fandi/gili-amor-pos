generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. DATA MASTER STAF
model Staff {
  staff_id       String         @id
  nama           String
  posisi         String
  desk           String?
  shift          String?
  pin            String?        @default("1234") // Tambahan kolom PIN untuk login
  active         Boolean        @default(true)
  
  transaksi      Transaksi[]
  cases          CaseFollowUp[]
  shift_closings ShiftClosing[]
}

// 2. DATA MASTER BARANG
model MasterItem {
  item_code       String            @id // Akan diisi manual (contoh: RENT-BIKE), tidak di-generate otomatis
  desk            String?           // Sesuai kolom Desk di blueprint
  category        String            // CHARGE, RENTAL, ACTIVITY, dll
  item_service    String            // Menggantikan nama_item
  billing_type    String            // PER_UNIT, PER_DAY, PER_PAX, PER_TRIP
  default_rate    Float             // Menggantikan harga
  active          Boolean           @default(true)
  notes           String?           // Sesuai kolom Notes di blueprint (contoh: Payment only)
  
  // Tambahkan baris wajib ini agar terhubung dengan DetailTransaksi:
  DetailTransaksi DetailTransaksi[]
}

// 3. DATA TRANSAKSI UTAMA
model Transaksi {
  no_transaksi   String            @id
  tanggal        DateTime          @default(now())
  waktu          DateTime          @default(now())
  desk           String?
  nama_tamu      String?
  room           String?
  reference      String?
  grand_total    Int
  amount_paid    Int
  balance        Int
  payment_status String
  payment_method String
  remark         String?
  
  staff_id       String
  staff          Staff             @relation(fields: [staff_id], references: [staff_id])
  
  details        DetailTransaksi[]
}

// 4. RINCIAN KERANJANG BARANG
model DetailTransaksi {
  id           Int        @id @default(autoincrement())
  qty          Int
  duration     Int
  rate         Int
  discount     Int
  total        Int
  notes        String?

  no_transaksi String
  transaksi    Transaksi  @relation(fields: [no_transaksi], references: [no_transaksi])
  
  item_code    String
  item         MasterItem @relation(fields: [item_code], references: [item_code])
}

// 5. TUGAS OPERASIONAL (CASE)
model CaseFollowUp {
  case_no     String    @id
  tanggal     DateTime  @default(now())
  waktu       DateTime  @default(now())
  desk        String?
  case_type   String?
  nama_tamu   String?
  room        String?
  priority    String?
  status      String
  due_date    DateTime?
  description String?

  assigned_to String
  staff       Staff     @relation(fields: [assigned_to], references: [staff_id])
}

// 6. TUTUP KASIR
model ShiftClosing {
  close_no      String   @id
  tanggal       DateTime @default(now())
  shift         String?
  opening_cash  Int
  cash_sales    Int
  card_sales    Int
  expected_cash Int
  actual_cash   Int
  variance      Int

  staff_id      String
  staff         Staff    @relation(fields: [staff_id], references: [staff_id])
}